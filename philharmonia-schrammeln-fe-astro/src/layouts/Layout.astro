---
import {SchrammelNavbar} from "../components/base/navbar/Navbar.tsx";
import Footer from "../components/base/Footer.astro";
interface Props {
    title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="de-AT">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content="Astro description"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
    <SchrammelNavbar client:load/>

</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-800">


<slot name="outerSlot" class=""/>

<div class="flex-grow w-full mt-40 max-w-7xl mx-auto px-4  sm:px-6 lg:px-8">
    <main class="py-8">
        <slot name="content" />
    </main>
</div>

<Footer />
</body>
</html>

